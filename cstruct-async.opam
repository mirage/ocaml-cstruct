opam-version: "2.0"
maintainer:   "anil@recoil.org"
authors:      ["Anil Madhavapeddy" "Richard Mortier" "Thomas Gazagnaire"
               "Pierre Chambart" "David Kaloper" "Jeremy Yallop" "David Scott"
               "Mindy Preston" "Thomas Leonard" "Etienne Millon" ]
homepage:     "https://github.com/mirage/ocaml-cstruct"
license:      "ISC"
dev-repo: "git+https://github.com/mirage/ocaml-cstruct.git"
bug-reports:  "https://github.com/mirage/ocaml-cstruct/issues"
tags: [ "org:mirage" "org:ocamllabs" ]
doc: "https://mirage.github.io/ocaml-cstruct/"
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "4.08.0"}
  "dune" {>= "3.17"}
]
post-messages: [
  "cstruct-async is deprecated and installs no library. Use Cstruct directly
   with Async; see the DEPRECATED.md installed with this package for the
   conversion functions that Async_cstruct used to provide."
]
synopsis: "Deprecated transitional package, use cstruct with Async directly"
description: """
This package used to provide the Async_cstruct library, a thin adapter between
Cstruct.t and Bigsubstring.t.  Async and Core now depend on cstruct themselves,
so the shim only widened the dependency cone of the cstruct repository and has
been removed.

The package is retained as an empty transitional package so that existing
installations keep resolving, and it will be deleted in a future release.  It
installs a DEPRECATED.md document containing the source of the old library, so
that the few functions it offered can be copied into projects that still need
them."""
x-maintenance-intent: [ "(latest)" ]
